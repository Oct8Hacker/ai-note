# Demo profile (SRS §15.4). Layer it on top of .env:
#   docker compose -f deploy/docker-compose.yml --env-file .env --env-file deploy/demo.env up -d
# Compose substitutes these into the gateway/worker `environment:` blocks.
# No secrets here — this file is committed.

# Short retries so dlq.sh dead-letters a private video in under a minute
# (3+6+12+24 = 45 s across MAX_ATTEMPTS=5).
RETRY_DELAYS=3s,6s,12s,24s

# 1.5 s per captured frame, so kill-worker.sh can catch a job in EXTRACTING_FRAMES.
FAULT_STAGE_DELAY_MS=1500
