# AI-Note configuration. Copy to .env (scripts/setup.sh or scripts/setup.ps1
# does this and fills the generated values). Never commit .env.
#
# Lines marked REQUIRED must have a value. Everything commented out shows its
# default; uncomment a line only to change it.

# ---------------------------------------------------------------- secrets
# REQUIRED. 32 random bytes, base64: encrypts Notion tokens inside queued jobs.
# setup.sh generates it (openssl rand -base64 32).
TOKEN_ENC_KEY=
# REQUIRED. Bearer token for /admin/* endpoints and the demo scripts. setup.sh generates it.
ADMIN_TOKEN=

# ---------------------------------------------------------------- LLM
# LLM provider: gemini | groq | openrouter | ollama
LLM_PROVIDER=gemini
# REQUIRED for gemini: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only the selected provider's key is needed.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_URL=http://ollama:11434
# Model name. Default for gemini: gemini-3.8-flash
# LLM_MODEL=gemini-3.8-flash
# Model used to verify captured frames; defaults to LLM_PROVIDER / LLM_MODEL.
# LLM_VISION_PROVIDER=gemini
# LLM_VISION_MODEL=gemini-3.8-flash
# Free tier: a model with a larger daily quota here (e.g. gemini-3.5-flash-lite)
# halves what each job costs the main model.
# Backup used when the main provider is down or out of quota (e.g. groq).
# LLM_FALLBACK_PROVIDER=
# LLM_FALLBACK_MODEL=
# Configured LLM rate limits, shared by all workers through Redis. Defaults are
# safe for a Gemini free-tier key; raise them for a paid key.
# Set LLM_RPM to one less than your model's free-tier requests per minute
# (4 for gemini-3-flash-preview, which allows 5): the limiter keeps a
# one-request reserve, so up to LLM_RPM + 1 calls can land in one minute.
# LLM_RPM=8
# LLM_TPM=200000
# LLM_RPD=200
# LLM_RPD_RESET_TZ=America/Los_Angeles
# LLM_MAX_INPUT_TOKENS=6000
# LLM_TIMEOUT=90s
# LIMITER_MAX_WAIT=60s

# ---------------------------------------------------------------- Notion
# The extension ID is pinned by the manifest key, so these two lines work on every machine.
CORS_ALLOWED_ORIGINS=chrome-extension://lbmicegifohcileflpbjdanghkgigcia
NOTION_REDIRECT_URI=https://lbmicegifohcileflpbjdanghkgigcia.chromiumapp.org/notion
# Full OAuth mode only (README → Notion, mode B). Leave empty for Quick mode.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Optional fixed destination (page or database ID) when a job doesn't name one.
NOTION_DEFAULT_PARENT_ID=
# NOTION_RPS=2.5
# NOTION_VERSION=2025-09-03
# NOTION_MAX_IMAGE_BYTES=4500000
# NOTION_UPLOAD_REUSE_WINDOW=50m

# ---------------------------------------------------------------- YouTube
# YouTube requests per second (yt-dlp calls and ffmpeg stream reads), shared by all workers.
# YOUTUBE_RPS=4
# Only if YouTube asks "confirm you're not a bot": export cookies to .ytdlp/cookies.txt
# (README → Troubleshooting) and uncomment:
# YTDLP_COOKIES_FILE=/ytdlp/cookies.txt

# ---------------------------------------------------------------- pipeline
# MAX_VIDEO_SECONDS=1200
# MAX_FRAMES=8
# FRAME_CONCURRENCY=4
# FRAME_TIMEOUT=30s   (per ffmpeg call; waiting for rate-limit tokens doesn't count)
# FRAME_VERIFY=true
# SCENE_THRESHOLD=0.3
# MAX_FRAME_DRIFT_SEC=3
# FRAME_DEDUP_WINDOW_SEC=5
# NOTES_LANGUAGE=English

# ---------------------------------------------------------------- broker and stores
# Broker connection string.
AMQP_URL=amqp://guest:guest@rabbitmq:5672/
DATABASE_URL=postgres://notes:notes@postgres:5432/notes?sslmode=disable
REDIS_URL=redis://redis:6379/0
# Used by the postgres container; keep in step with DATABASE_URL.
POSTGRES_USER=notes
POSTGRES_PASSWORD=notes
POSTGRES_DB=notes
# AMQP_HEARTBEAT=10s
# RABBITMQ_MGMT_URL=http://rabbitmq:15672
# RABBITMQ_USER=guest
# RABBITMQ_PASS=guest

# ---------------------------------------------------------------- retries and workers
# Failure retry budget, and the separate budget for rate-limit (429) retries.
# MAX_ATTEMPTS=5
# MAX_RATE_LIMIT_RETRIES=8
# Backoff schedule between failed attempts (deploy/demo.env shortens it).
# RETRY_DELAYS=10s,30s,90s,270s
# DEFER_DELAY=3s
# MAX_DEFERRALS=30
# DELIVERY_LIMIT=10
# LEASE_TTL=30s
# WORKER_HEARTBEAT_INTERVAL=2s
# WORKER_HEARTBEAT_TTL=6s
# WORKER_CONCURRENCY=1
# SHUTDOWN_GRACE=25s
# DOCTOR_INTERVAL=60s

# ---------------------------------------------------------------- gateway and logs
# GATEWAY_PORT=8080
# PUBLIC_BASE_URL=http://localhost:8080
# OUTBOX_SWEEP_INTERVAL=2s
# LOG_LEVEL=info

# ---------------------------------------------------------------- fault injection (demo)
# Usually toggled live with PUT /admin/faults instead.
# FAULT_LLM_429_RATE=0
# FAULT_NOTION_429_RATE=0
# FAULT_YOUTUBE_429_RATE=0
# FAULT_FRAME_FAIL_RATE=0
# FAULT_FRAME_FAIL_ALL=false
# FAULT_STAGE_DELAY_MS=0
