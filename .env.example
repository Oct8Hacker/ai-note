# Copy to .env and edit. Never commit .env.

# 32 random bytes, base64. Generate with:  openssl rand -base64 32
TOKEN_ENC_KEY=CHANGE_ME_base64_of_32_bytes
ADMIN_TOKEN=change-me-admin-token

# ollama needs no API key (smoke tests). For gemini set GEMINI_API_KEY.
LLM_PROVIDER=ollama
# GEMINI_API_KEY=

DATABASE_URL=postgres://notes:notes@postgres:5432/notes?sslmode=disable
AMQP_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0

POSTGRES_USER=notes
POSTGRES_PASSWORD=notes
POSTGRES_DB=notes
